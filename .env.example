# Generate with: openssl rand -hex 32
APP_ACCESS_TOKEN=
# Must exactly match the browser URL. Use HTTPS for any remote deployment.
PUBLIC_ORIGIN=http://localhost:5000
HOST=127.0.0.1
PORT=5000
# Optional. Without these, use the seeded local demo and no live AI/audio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Configure a single account for real data; never use this identifier as a password.
OMI_UID=
# Independent random secret for a trusted webhook relay; unset disables ingestion.
OMI_WEBHOOK_SECRET=
GCP_BUCKET_NAME=
GCP_SERVICE_ACCOUNT_JSON=
